.apply-footer__container {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 8px;
}

.generation-btn-container-row {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 8px;
}

.button {
    flex-shrink: 1;
    flex-grow: 0;
    margin-left: 10px;
    min-width: 75px;
}

#property-path {
    flex-grow: 1;
}

#property-path Label {
    max-width: 120px;
}

.group-path {
    flex-direction: row;
}

#assembly-definition .unity-base-field__label {
    min-width: 210px;
    width: 210px;
    flex-shrink: 0;
    margin-left: 0;
}

.last-deployment {
    margin-top: 4px;
    margin-left: 3px;
}

.last-deployment__header {
    margin-bottom: 2px;
}

.last-deployment__row {
    flex-direction: row;
}

.last-deployment__label {
    width: 212px;
    flex-shrink: 0;
    padding-left: 15px;
}
