<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1;">
        <ui:TextField label="Input" placeholder-text="Enter a name" name="NameInput" />
        <ui:Button text="Invoke Cloud Code Module" name="InvokeCloudCodeButton" />
        <ui:Label text="Cloud Response:" name="ResultLabel" />
        <ui:IntegerField label="Delay (seconds)" value="5" name="DelaySeconds" />
        <ui:Button text="Schedule Greeting" name="ScheduleGreetingButton" />
        <ui:Label text="Timer Status:" name="StatusLabel" />
    </ui:VisualElement>
</ui:UXML>
